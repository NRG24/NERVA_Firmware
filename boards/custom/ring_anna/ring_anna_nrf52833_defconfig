CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

CONFIG_GPIO=y
CONFIG_I2C=y

# No 32.768 kHz crystal on this board: XL1/XL2 (module pins 17/18) are tied
# to GND, which is what the ANNA-B402 datasheet specifies for "not used".
# Run LFCLK from the internal RC.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION=y
